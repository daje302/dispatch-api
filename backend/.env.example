# ===== App =====
NODE_ENV=development
PORT=4000
# Clave secreta para firmar JWT (cambiar en producción)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# ===== Base de datos PostgreSQL =====
DATABASE_URL=postgresql://dispatch:dispatch123@localhost:5432/dispatch_db
# (string de conexión completa; usada por el pool de conexiones)

# ===== Base de datos (configuración explícita) =====
PGHOST=localhost
PGPORT=5432
PGDATABASE=dispatch_db
PGUSER=dispatch
PGPASSWORD=dispatch123

# ===== Stripe =====
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx
# Precios creados manualmente o por el seed (IDs de prices de Stripe)
STRIPE_PRICE_BASIC=price_xxxx_basic
STRIPE_PRICE_PRO=price_xxxx_pro
# URL base del app (para redirecciones de checkout y webhooks)
APP_URL=http://localhost:4000

# ===== Integración con software de despacho de terceros =====
# provider: 'mock' (desarrollo) | 'onfleet' | 'shipbubble' | 'dispatchtrack' | etc.
DISPATCH_PROVIDER=mock
DISPATCH_BASE_URL=https://api.tudespachador.com
DISPATCH_API_KEY=tu-api-key-aqui
